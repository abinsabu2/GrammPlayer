<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/detail_primary_container" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="@color/detail_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F4A47" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/detail_surface_container_highest" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>