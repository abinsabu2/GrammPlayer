<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark theatre room -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#060304"
                android:startColor="#1A0A10"
                android:type="linear" />
        </shape>
    </item>

    <!-- Ceiling wash -->
    <item android:height="48dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="#33FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Left curtain -->
    <item
        android:gravity="start|fill_vertical"
        android:width="72dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#00000000"
                android:startColor="#B71C3A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Right curtain -->
    <item
        android:gravity="end|fill_vertical"
        android:width="72dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:endColor="#00000000"
                android:startColor="#B71C3A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Floor / seats glow -->
    <item android:gravity="bottom" android:height="56dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#55201528"
                android:type="linear" />
        </shape>
    </item>
</layer-list>