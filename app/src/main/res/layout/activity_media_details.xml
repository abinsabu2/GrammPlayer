<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0F"
    android:orientation="vertical"
    tools:context=".ui.features.details.MediaDetailsActivity">

    <!-- App bar: logo/app name + promo banner + close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0A0A0C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/app_icon_your_company"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/detail_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/promo_banner"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:maxWidth="420dp">

            <TextView
                android:id="@+id/promo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="NEW EPISODES: The Great Barrier Reef — Exclusively This Month!" />
        </FrameLayout>
    </LinearLayout>

    <!-- Main content — top-aligned, no stretchy middle gap -->
    <LinearLayout
        android:id="@+id/details_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:orientation="vertical">

        <!-- Preview theatre + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:orientation="vertical">

            <!-- Inline preview — movie theater styling -->
            <FrameLayout
                android:id="@+id/preview_container"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:background="@drawable/preview_theatre_background"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/preview_screen_frame"
                    android:padding="4dp">

                    <FrameLayout
                        android:id="@+id/preview_video_host"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#000000" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="8dp"
                    android:background="#99000000"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/preview_label"
                    android:textColor="@color/detail_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/preview_fullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/button_outline_background"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_play_arrow"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_fullscreen"
                        android:textColor="@color/detail_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Close — right-aligned below preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/action_close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/close_button_background"
                    android:clickable="true"
                    android:contentDescription="@string/close_button_description"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_cancel" />
            </LinearLayout>
        </LinearLayout>

        <!-- Poster + details — compact, sits directly under preview/close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <androidx.cardview.widget.CardView
                xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="450dp"
                android:layout_height="450dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <ImageView
                    android:id="@+id/poster_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/detail_back_drop" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="@color/detail_text_primary"
                    android:textSize="@dimen/detail_title_text"
                    android:textStyle="bold"
                    tools:text="THE ABYSSAL DEEPS" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="0.06"
                    android:text="@string/description"
                    android:textAllCaps="true"
                    android:textColor="@color/detail_text_label"
                    android:textSize="@dimen/detail_label_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:textColor="@color/detail_text_body"
                    android:textSize="@dimen/detail_body_text"
                    tools:text="Journey to the crushing depths of the deep ocean, where only light can find you." />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:scrollbars="none">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/metadata_chip_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/item_metadata_chip" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/download_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="63dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/download_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/detail_text_primary"
                        android:textSize="@dimen/detail_body_text"
                        tools:text="Downloading — 512 MB / 8.41 GB" />

                    <ProgressBar
                        android:id="@+id/download_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:max="100"
                        android:progressDrawable="@drawable/custom_progress" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/bg_settings_container"
                    android:clipToOutline="true"
                    android:scrollbars="none">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/settings_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        tools:listitem="@layout/item_setting_card" />
                </HorizontalScrollView>

                <!-- Log toggle (left) + action buttons (right-aligned) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_settings_container"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/action_toggle_log"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/detail_action_button_height"
                        android:background="@drawable/button_outline_background"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_layers"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/toggle_log_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/toggle_log_show"
                            android:textColor="@color/detail_text_primary"
                            android:textSize="@dimen/detail_button_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/action_play"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/detail_action_button_height"
                            android:background="@drawable/button_outline_background"
                            android:defaultFocusHighlightEnabled="false"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                android:src="@drawable/ic_play_arrow"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/play"
                                android:textColor="@color/detail_text_primary"
                                android:textSize="@dimen/detail_button_text"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/action_download"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/detail_action_button_height"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/button_outline_background"
                            android:defaultFocusHighlightEnabled="false"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                android:src="@drawable/ic_download"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/download"
                                android:textColor="@color/detail_text_primary"
                                android:textSize="@dimen/detail_button_text"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/action_cancel"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/detail_action_button_height"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/button_outline_background"
                            android:defaultFocusHighlightEnabled="false"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingEnd="24dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="10dp"
                                android:src="@drawable/ic_cancel"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cancel"
                                android:textColor="@color/detail_text_primary"
                                android:textSize="@dimen/detail_button_text"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Activity log — fixed-height strip at bottom; scrolls internally only -->
    <LinearLayout
        android:id="@+id/activity_log_container"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="#141416"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/activity_log_title"
                android:textColor="@color/detail_text_label"
                android:textSize="@dimen/detail_label_text" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_app_logo"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/log_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/detail_text_body"
                android:textSize="13sp"
                tools:text="[09:30:20] Submersible checks complete... Success." />
        </ScrollView>
    </LinearLayout>
</LinearLayout>