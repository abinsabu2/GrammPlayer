<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0F"
    android:fillViewport="true"
    tools:context=".ui.features.details.MediaDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App bar: logo/app name + promo banner + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="#0A0A0C">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/app_icon_your_company"
                tools:ignore="ContentDescription" />

            <!-- TODO: replace with real app name from strings.xml / branding -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Promo banner — TODO: bind to a real promo/announcement source
                 instead of this static placeholder -->
            <FrameLayout
                android:id="@+id/promo_banner"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="24dp"
                android:maxWidth="420dp">

                <TextView
                    android:id="@+id/promo_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="14dp"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="NEW EPISODES: The Great Barrier Reef — Exclusively This Month!" />
            </FrameLayout>

            <!-- Close button — returns to the previous screen -->
            <ImageView
                android:id="@+id/action_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:padding="8dp"
                android:src="@drawable/ic_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Poster + details row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp">

            <ImageView
                android:id="@+id/poster_image"
                android:layout_width="220dp"
                android:layout_height="300dp"
                android:background="@color/detail_backdrop_background"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="6dp"
                    tools:text="THE ABYSSAL DEEPS" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCRIPTION"
                    android:textColor="#7A7A7E"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#C9C9C9"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="16dp"
                    tools:text="Journey to the crushing depths of the deep ocean, where only light can find you." />

                <!-- Metadata tag chips: genre/audio/duration etc.
                     TODO: these fields don't exist on MediaMessage yet —
                     wire up real tags/audio/duration once the model has them. -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="18dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/metadata_chip_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/item_metadata_chip" />
                </HorizontalScrollView>

                <!-- Download progress — hidden until a download is active -->
                <LinearLayout
                    android:id="@+id/download_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/download_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"
                        tools:text="Downloading — 512 MB / 8.41 GB" />

                    <ProgressBar
                        android:id="@+id/download_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:progressTint="@color/accent_teal"
                        android:max="100" />
                </LinearLayout>

                <!-- Settings row: autoplay / buffer / quality / storage / connection -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="20dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/settings_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:listitem="@layout/item_setting_card" />
                </HorizontalScrollView>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/action_download"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/button_outline_background"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingStart="20dp"
                        android:paddingEnd="24dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_download"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DOWNLOAD"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/action_play"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="14dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/button_outline_background"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingStart="20dp"
                        android:paddingEnd="24dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_play_arrow"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PLAY"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/action_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="14dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/button_outline_background"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:paddingStart="20dp"
                        android:paddingEnd="24dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_cancel"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CANCEL"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Activity log panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="140dp"
            android:orientation="vertical"
            android:background="#141416"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVITY LOG"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:letterSpacing="0.05" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_app_logo"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <TextView
                android:id="@+id/log_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="6"
                android:scrollbars="vertical"
                android:textColor="#8A8A8E"
                android:textSize="12sp"
                tools:text="[09:30:20] Submersible checks complete... Success.\n[09:30:25] Depth sensor calibrated. Status: Active." />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>