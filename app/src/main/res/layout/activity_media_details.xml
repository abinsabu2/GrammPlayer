<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.features.details.MediaDetailsActivity">

    <ImageView
        android:id="@+id/detail_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/detail_backdrop_video_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:visibility="visible" />

    <View
        android:id="@+id/detail_backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/detail_backdrop_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/detail_page_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/detail_page_background"
        android:orientation="vertical">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/detail_app_bar_height"
        android:background="@drawable/detail_app_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/detail_screen_padding_h"
        android:paddingEnd="@dimen/detail_screen_padding_h">

        <ImageView
            android:layout_width="@dimen/detail_app_icon_size"
            android:layout_height="@dimen/detail_app_icon_size"
            android:layout_marginEnd="@dimen/detail_section_gap"
            android:src="@drawable/app_icon_your_company"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/detail_text_primary"
            android:textSize="@dimen/detail_app_name_text"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/promo_banner"
            android:layout_width="0dp"
            android:layout_height="@dimen/detail_promo_height"
            android:layout_marginStart="@dimen/detail_content_gap"
            android:layout_weight="1"
            android:maxWidth="420dp">

            <TextView
                android:id="@+id/promo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/detail_section_gap"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/detail_text_primary"
                android:textSize="@dimen/detail_promo_text"
                android:textStyle="bold"
                tools:text="NEW EPISODES: The Great Barrier Reef — Exclusively This Month!" />
        </FrameLayout>
    </LinearLayout>

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/details_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/details_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- Preview + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/detail_screen_padding_h"
            android:layout_marginTop="@dimen/detail_screen_padding_v"
            android:layout_marginEnd="@dimen/detail_screen_padding_h"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingTop="@dimen/detail_section_gap"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/action_close"
                    android:layout_width="@dimen/detail_close_size"
                    android:layout_height="@dimen/detail_close_size"
                    android:background="@drawable/close_button_background"
                    android:clickable="true"
                    android:contentDescription="@string/close_button_description"
                    android:focusable="true"
                    android:padding="@dimen/detail_close_padding"
                    android:src="@drawable/ic_cancel" />
            </LinearLayout>
        </LinearLayout>

        <!-- Poster + details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingTop="@dimen/detail_section_gap"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:paddingBottom="@dimen/detail_screen_padding_v">

            <ImageView
                android:id="@+id/poster_image"
                android:layout_width="@dimen/detail_poster_width"
                android:layout_height="@dimen/detail_poster_height"
                android:background="@color/detail_backdrop_background"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/detail_content_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:ellipsize="end"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="@color/detail_text_primary"
                    android:textSize="@dimen/detail_title_text"
                    android:textStyle="bold"
                    tools:text="THE ABYSSAL DEEPS" />

                <TextView
                    android:id="@+id/tagline_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/detail_section_gap"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/detail_text_muted"
                    android:textSize="@dimen/detail_body_text"
                    android:textStyle="italic"
                    android:visibility="gone"
                    tools:text="Fear reaches new depths."
                    tools:visibility="visible" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:letterSpacing="0.06"
                    android:text="@string/detail_section_synopsis"
                    android:textAllCaps="true"
                    android:textColor="@color/detail_text_label"
                    android:textSize="@dimen/detail_label_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/detail_section_gap"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="4"
                    android:textColor="@color/detail_text_body"
                    android:textSize="@dimen/detail_body_text"
                    tools:text="Journey to the crushing depths of the deep ocean, where only light can find you." />

                <LinearLayout
                    android:id="@+id/download_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/detail_section_gap"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/download_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/detail_text_primary"
                        android:textSize="@dimen/detail_body_text"
                        tools:text="Downloading — 512 MB / 8.41 GB" />

                    <ProgressBar
                        android:id="@+id/download_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/detail_progress_height"
                        android:max="100"
                        android:progressDrawable="@drawable/custom_progress" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Movie info -->
        <LinearLayout
            android:id="@+id/movie_info_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:paddingBottom="@dimen/detail_section_gap"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:letterSpacing="0.06"
                android:text="@string/detail_section_movie_info"
                android:textAllCaps="true"
                android:textColor="@color/detail_text_label"
                android:textSize="@dimen/detail_label_text"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/detail_section_gap"
                android:scrollbars="none">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/movie_stats_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_detail_stat" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/original_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/detail_text_muted"
                android:textSize="@dimen/detail_label_text"
                android:visibility="gone"
                tools:text="Original: Dune: Part Two"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Genres -->
        <LinearLayout
            android:id="@+id/genres_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:paddingBottom="@dimen/detail_section_gap"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:letterSpacing="0.06"
                android:text="@string/detail_section_genres"
                android:textAllCaps="true"
                android:textColor="@color/detail_text_label"
                android:textSize="@dimen/detail_label_text"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/genre_chip_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_metadata_chip" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Cast -->
        <LinearLayout
            android:id="@+id/cast_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:paddingBottom="@dimen/detail_section_gap"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:letterSpacing="0.06"
                android:text="@string/detail_section_cast"
                android:textAllCaps="true"
                android:textColor="@color/detail_text_label"
                android:textSize="@dimen/detail_label_text"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/cast_chip_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_cast_chip" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Crew -->
        <LinearLayout
            android:id="@+id/crew_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:paddingBottom="@dimen/detail_section_gap"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:letterSpacing="0.06"
                android:text="@string/detail_section_crew"
                android:textAllCaps="true"
                android:textColor="@color/detail_text_label"
                android:textSize="@dimen/detail_label_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/crew_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/detail_text_body"
                android:textSize="@dimen/detail_body_text"
                tools:text="Director: Denis Villeneuve&#10;Writer: Jon Spaihts" />
        </LinearLayout>

        <!-- File details -->
        <LinearLayout
            android:id="@+id/file_details_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:paddingBottom="@dimen/detail_section_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:letterSpacing="0.06"
                android:text="@string/detail_section_file_details"
                android:textAllCaps="true"
                android:textColor="@color/detail_text_label"
                android:textSize="@dimen/detail_label_text"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/file_metadata_chip_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_metadata_chip" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Playback settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/detail_screen_padding_h"
            android:layout_marginBottom="2dp"
            android:letterSpacing="0.06"
            android:text="@string/detail_section_playback"
            android:textAllCaps="true"
            android:textColor="@color/detail_text_label"
            android:textSize="@dimen/detail_label_text"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/detail_section_gap"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:scrollbars="none">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/settings_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_setting_card" />
        </HorizontalScrollView>

            </LinearLayout>
        </ScrollView>

        <!-- Fixed action bar -->
        <LinearLayout
            android:id="@+id/details_actions_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/detail_app_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/detail_screen_padding_h"
            android:paddingTop="@dimen/detail_section_gap"
            android:paddingEnd="@dimen/detail_screen_padding_h"
            android:paddingBottom="@dimen/detail_section_gap">

            <LinearLayout
                android:id="@+id/action_toggle_log"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/detail_action_button_height"
                android:background="@drawable/detail_button_outlined"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/detail_button_padding_start"
                android:paddingEnd="@dimen/detail_button_padding_end">

                <ImageView
                    android:layout_width="@dimen/detail_button_icon_size"
                    android:layout_height="@dimen/detail_button_icon_size"
                    android:layout_marginEnd="@dimen/detail_section_gap"
                    android:src="@drawable/ic_layers"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/toggle_log_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/toggle_log_show"
                    android:textColor="@color/detail_text_primary"
                    android:textSize="@dimen/detail_button_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/action_play"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/detail_action_button_height"
                    android:background="@drawable/detail_button_outlined"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/detail_button_padding_start"
                    android:paddingEnd="@dimen/detail_button_padding_end">

                    <ImageView
                        android:layout_width="@dimen/detail_button_icon_size"
                        android:layout_height="@dimen/detail_button_icon_size"
                        android:layout_marginEnd="@dimen/detail_section_gap"
                        android:src="@drawable/ic_play_arrow"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/play"
                        android:textColor="@color/detail_text_primary"
                        android:textSize="@dimen/detail_button_text"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_download"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/detail_action_button_height"
                    android:layout_marginStart="@dimen/detail_button_gap"
                    android:background="@drawable/detail_button_outlined"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/detail_button_padding_start"
                    android:paddingEnd="@dimen/detail_button_padding_end">

                    <ImageView
                        android:layout_width="@dimen/detail_button_icon_size"
                        android:layout_height="@dimen/detail_button_icon_size"
                        android:layout_marginEnd="@dimen/detail_section_gap"
                        android:src="@drawable/ic_download"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download"
                        android:textColor="@color/detail_text_primary"
                        android:textSize="@dimen/detail_button_text"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/detail_action_button_height"
                    android:layout_marginStart="@dimen/detail_button_gap"
                    android:background="@drawable/detail_button_outlined"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/detail_button_padding_start"
                    android:paddingEnd="@dimen/detail_button_padding_end"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/detail_button_icon_size"
                        android:layout_height="@dimen/detail_button_icon_size"
                        android:layout_marginEnd="@dimen/detail_section_gap"
                        android:src="@drawable/ic_cancel"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cancel"
                        android:textColor="@color/detail_text_primary"
                        android:textSize="@dimen/detail_button_text"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Activity log -->
    <LinearLayout
        android:id="@+id/activity_log_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/detail_log_height"
        android:background="@drawable/detail_log_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/detail_log_padding_h"
        android:paddingTop="@dimen/detail_log_padding_v"
        android:paddingEnd="@dimen/detail_log_padding_h"
        android:paddingBottom="@dimen/detail_log_padding_v"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/detail_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/activity_log_title"
                android:textColor="@color/detail_text_label"
                android:textSize="@dimen/detail_label_text" />

            <ImageView
                android:layout_width="@dimen/detail_chip_icon_size"
                android:layout_height="@dimen/detail_chip_icon_size"
                android:layout_marginStart="@dimen/detail_section_gap"
                android:src="@drawable/ic_app_logo"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/log_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/detail_text_body"
                android:textSize="@dimen/detail_log_text"
                tools:text="[09:30:20] Submersible checks complete... Success." />
        </ScrollView>
    </LinearLayout>
    </LinearLayout>

    <!-- Floating fullscreen control over background preview -->
    <LinearLayout
        android:id="@+id/preview_fullscreen"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/detail_preview_fullscreen_height"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/detail_screen_padding_h"
        android:layout_marginBottom="64dp"
        android:background="@drawable/detail_button_outlined"
        android:defaultFocusHighlightEnabled="false"
        android:elevation="6dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/detail_button_padding_start"
        android:paddingEnd="@dimen/detail_button_padding_end"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/detail_button_icon_size"
            android:layout_height="@dimen/detail_button_icon_size"
            android:layout_marginEnd="@dimen/detail_section_gap"
            android:src="@drawable/ic_play_arrow"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_fullscreen"
            android:textColor="@color/detail_text_primary"
            android:textSize="@dimen/detail_button_text"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>