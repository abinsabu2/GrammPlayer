<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/detail_surface_base"
    tools:context=".ui.features.authentication.LoginActivity">

    <!-- App Title -->
    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connect_with_telegram"
        android:textColor="@color/detail_text_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/subtitleTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/subtitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/login_subtitle"
        android:textColor="@color/detail_text_label"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/panelsRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView" />

    <!-- Two login panels: phone (left) and QR (right) -->
    <LinearLayout
        android:id="@+id/panelsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleTextView">

        <!-- Phone Login Panel -->
        <LinearLayout
            android:id="@+id/phonePanel"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:minHeight="360dp"
            android:background="@drawable/setting_card_background"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_phone_title"
                android:textColor="@color/detail_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/phoneStepHintTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/login_phone_step_hint"
                android:textColor="@color/detail_text_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <!-- Country Code Input Field -->
                <EditText
                    android:id="@+id/countryCodeEditText"
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/login_input_background"
                    android:hint="@string/country_code_hint"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textColor="@color/detail_text_primary"
                    android:textColorHint="@color/detail_text_muted"
                    android:textSize="20sp" />

                <!-- Phone Number Input Field -->
                <EditText
                    android:id="@+id/phoneNumberEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/login_input_background"
                    android:hint="@string/phone_hint"
                    android:imeOptions="actionNext"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:padding="16dp"
                    android:textColor="@color/detail_text_primary"
                    android:textColorHint="@color/detail_text_muted"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Auth Code Input Field -->
            <EditText
                android:id="@+id/authCodeEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/login_input_background"
                android:hint="@string/authentication_code"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLines="1"
                android:padding="16dp"
                android:textColor="@color/detail_text_primary"
                android:textColorHint="@color/detail_text_muted"
                android:textSize="20sp"
                android:visibility="gone" />

            <!-- 2FA Password Input Field -->
            <EditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/login_input_background"
                android:fontFamily="sans-serif"
                android:hint="@string/password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="16dp"
                android:textColor="@color/detail_text_primary"
                android:textColorHint="@color/detail_text_muted"
                android:textSize="20sp"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/submitButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/login_button_filled"
                android:text="@string/submit"
                android:textAllCaps="false"
                android:textColor="@drawable/custom_button_text_color"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="@string/login_or"
            android:textColor="@color/detail_text_muted"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- QR Login Panel -->
        <LinearLayout
            android:id="@+id/qrPanel"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:minHeight="360dp"
            android:background="@drawable/setting_card_background"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_qr_title"
                android:textColor="@color/detail_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- QR Login Code -->
            <ImageView
                android:id="@+id/qrImageView"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@android:color/white"
                android:contentDescription="@string/qr_login_description"
                android:padding="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/qrInstructionsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/qr_generating"
                android:textColor="@color/detail_text_muted"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Log Popup -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="#333333"
        app:cardCornerRadius="8dp"
        app:cardElevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="450dp"
            android:background="@color/button_default_text"
            android:gravity="center|center"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="@color/text_color_on_dark"
                android:indeterminateTintMode="src_in" />

            <TextView
                android:id="@+id/logTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#A9A9A9"
                android:textSize="14sp"
                tools:text="[10:30:01] Initializing client..." />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
