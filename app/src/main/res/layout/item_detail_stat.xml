<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/detail_section_gap"
    android:background="@drawable/metadata_chip_background"
    android:gravity="center"
    android:minWidth="72dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/detail_text_primary"
        android:textSize="@dimen/detail_body_text"
        android:textStyle="bold"
        tools:text="★ 8.2" />

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:textColor="@color/detail_text_label"
        android:textSize="@dimen/detail_label_text"
        tools:text="Rating" />
</LinearLayout>