<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/detail_section_gap"
    android:background="@drawable/metadata_chip_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/detail_chip_padding_h"
    android:paddingTop="6dp"
    android:paddingEnd="@dimen/detail_chip_padding_h"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/cast_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/detail_text_primary"
        android:textSize="@dimen/detail_chip_text"
        android:textStyle="bold"
        tools:text="Timothée Chalamet" />

    <TextView
        android:id="@+id/cast_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/detail_text_muted"
        android:textSize="@dimen/detail_label_text"
        tools:text="Paul Atreides" />
</LinearLayout>