<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/grid_card_media_width"
    android:layout_height="@dimen/grid_card_media_height"
    android:layout_margin="@dimen/grid_card_margin"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:padding="@dimen/grid_card_padding"
    android:background="@drawable/card_background_selector"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:layout_width="@dimen/grid_card_thumbnail_size"
        android:layout_height="@dimen/grid_card_thumbnail_size"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/grid_card_thumbnail_margin_end"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:background="@drawable/card_background">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_media_placeholder"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical|start">

        <TextView
            android:id="@+id/banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/accent_teal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Available locally"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="@dimen/grid_card_title_text"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Some media title" />

        <TextView
            android:id="@+id/file_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B0B0B0"
            android:textSize="@dimen/grid_card_body_text"
            tools:text="File ID: 12345" />

        <TextView
            android:id="@+id/size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#B0B0B0"
            android:textSize="@dimen/grid_card_body_text"
            tools:text="Size: 3.42 MB" />

        <TextView
            android:id="@+id/quality_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#B0B0B0"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="720p · H.265 · NF WEB-DL"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/release_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#808080"
            android:textSize="9sp"
            android:textStyle="italic"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="CPTN5DW" />
    </LinearLayout>
</LinearLayout>