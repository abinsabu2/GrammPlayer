<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_media_message_detail.xml
     Uses ONLY standard Android views — no Material/AppCompat components.
     Safe for any Leanback theme. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Hero ───────────────────────────────────────────────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/iv_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Scrim -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#88000000" />

            <!-- Back button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="#66000000"
                android:src="@android:drawable/ic_menu_revert"
                android:padding="8dp"
                android:contentDescription="Back" />

            <!-- Thumbnail -->
            <ImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="64dp"
                android:layout_height="90dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:background="#222222"
                android:contentDescription="@null" />

            <!-- Card image -->
            <ImageView
                android:id="@+id/iv_card_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:background="#222222"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- ── Body ───────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                tools:text="Big Buck Bunny" />

            <!-- Studio -->
            <TextView
                android:id="@+id/tv_studio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:textColor="#4FC3F7"
                tools:text="Blender Foundation" />

            <!-- Status badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_is_media"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_badge"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    tools:text="Media" />

                <TextView
                    android:id="@+id/chip_downloaded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_badge"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    tools:text="Downloaded" />

                <TextView
                    android:id="@+id/chip_download_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_badge"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    tools:text="Idle" />

            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_play"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/btn_download"
                    android:textAllCaps="false" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:background="#33FFFFFF" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_description"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textColor="#88FFFFFF" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:lineSpacingMultiplier="1.4"
                tools:text="No description." />

            <!-- ── MEDIA INFO ─────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_media_info"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textColor="#4FC3F7" />

            <!-- Duration -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_duration" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#FFFFFF" tools:text="1:24:33" />
            </LinearLayout>

            <!-- Resolution -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_resolution" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_resolution" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#FFFFFF" tools:text="1920 × 1080" />
            </LinearLayout>

            <!-- Size -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_size" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_size" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#FFFFFF" tools:text="748 MB" />
            </LinearLayout>

            <!-- MIME type -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_mime_type" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_mime_type" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#FFFFFF" tools:text="video/mp4" />
            </LinearLayout>

            <!-- ── PATHS ──────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_paths"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textColor="#4FC3F7" />

            <!-- Local path -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_local_path" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_local_path" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="2" android:textSize="12sp" android:textColor="#FFFFFF"
                    android:fontFamily="monospace" android:ellipsize="middle" android:maxLines="2"
                    tools:text="/storage/emulated/0/Download/video.mp4" />
            </LinearLayout>

            <!-- Video URL -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_video_url" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_video_url" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="2" android:textSize="12sp" android:textColor="#FFFFFF"
                    android:fontFamily="monospace" android:ellipsize="end" android:maxLines="2"
                    tools:text="https://example.com/video.mp4" />
            </LinearLayout>

            <!-- ── IDENTIFIERS ────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_identifiers"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:textColor="#4FC3F7" />

            <!-- Message ID -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_message_id" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_message_id" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#FFFFFF" android:fontFamily="monospace"
                    tools:text="727566175075960653" />
            </LinearLayout>

            <!-- File ID -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_file_id" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_file_id" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#FFFFFF" android:fontFamily="monospace"
                    tools:text="#42" />
            </LinearLayout>

            <!-- Chat ID -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_chat_id" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_chat_id" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="#FFFFFF" android:fontFamily="monospace"
                    tools:text="7" />
            </LinearLayout>

            <!-- Unique ID -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_unique_id" android:textSize="12sp" android:textColor="#88FFFFFF" />
                <TextView android:id="@+id/tv_unique_id" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="2" android:textSize="13sp" android:textColor="#FFFFFF"
                    android:fontFamily="monospace" android:ellipsize="middle" android:singleLine="true"
                    tools:text="uid-abc-123-xyz-456" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>