<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/detail_chip_height"
    android:layout_marginEnd="@dimen/detail_section_gap"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/metadata_chip_background"
    android:paddingStart="@dimen/detail_chip_padding_h"
    android:paddingEnd="@dimen/detail_chip_padding_h">

    <ImageView android:id="@+id/icon"
        android:layout_width="@dimen/detail_chip_icon_size"
        android:layout_height="@dimen/detail_chip_icon_size"
        android:layout_marginEnd="6dp"
        app:tint="@color/detail_primary"
        tools:ignore="ContentDescription"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/detail_text_primary"
        android:textSize="@dimen/detail_chip_text"
        tools:text="Adventure"
        xmlns:tools="http://schemas.android.com/tools" />
</LinearLayout>